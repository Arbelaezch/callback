# .env.example — copy to .env and fill in values
# Never commit .env to git

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CALLBACK_SECRET=
# Number of reverse proxies in front of Django (used to find the client IP for
# login/register throttles). 0 = use REMOTE_ADDR and ignore X-Forwarded-For (dev).
# Prod sets 1 in docker-compose.prod.yml, behind host nginx (deploy/nginx) which
# overwrites X-Forwarded-For. See AGENTS.md (Settings) and
# https://github.com/Arbelaezch/callback/issues/23
NUM_PROXIES=0
# Optional redis URL so throttle counters are shared across gunicorn workers.
# Unset = per-process memory cache (dev). Prod builds it in docker-compose.prod.yml
# from REDIS_PASSWORD (redis DB 1), so REDIS_PASSWORD must be URL-safe.
CACHE_URL=

# Django admin
u=
p=

# Database
POSTGRES_DB=callback
POSTGRES_USER=callback
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://callback:changeme@db:5432/callback

# Redis / Celery
REDIS_PASSWORD=changeme
CELERY_BROKER_URL=redis://:changeme@redis:6379/0
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/0

# AWS
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

USE_S3=True
AWS_S3_BUCKET=

USE_LAMBDA=False # True in prod
AWS_LAMBDA_FUNCTION_NAME=

# APIs
ANTHROPIC_API_KEY=
JSEARCH_API_KEY=

# Email (Django built-in SMTP → AWS SES later)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Monitoring
SENTRY_DSN=

# Stripe (post-MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used by the browser (client-side fetches)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Used by Next.js server-side (inside Docker network)
INTERNAL_API_URL=http://backend:8000
