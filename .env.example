# .env.example — copy to .env and fill in values
# Never commit .env to git

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CALLBACK_SECRET=

# Django admin
u=
p=

# Database
POSTGRES_DB=callback
POSTGRES_USER=callback
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://callback:changeme@db:5432/callback

# Redis / Celery
REDIS_PASSWORD=changeme
CELERY_BROKER_URL=redis://:changeme@redis:6379/0
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/0

# AWS
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

USE_S3=True
AWS_S3_BUCKET=

USE_LAMBDA=False # True in prod
AWS_LAMBDA_FUNCTION_NAME=

# APIs
ANTHROPIC_API_KEY=
JSEARCH_API_KEY=

# Email (Django built-in SMTP → AWS SES later)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Monitoring
SENTRY_DSN=

# Stripe (post-MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used by the browser (client-side fetches)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Used by Next.js server-side (inside Docker network)
INTERNAL_API_URL=http://backend:8000
