# .env.example — copy to .env and fill in values
# Never commit .env to git

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Django admin
u=
p=

# Database
POSTGRES_DB=callback
POSTGRES_USER=callback
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://callback:changeme@db:5432/callback

# Redis / Celery
REDIS_PASSWORD=changeme
CELERY_BROKER_URL=redis://:changeme@redis:6379/0
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/0

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=callback-files
AWS_LAMBDA_FUNCTION_NAME=callback-submit-application

# APIs
ANTHROPIC_API_KEY=
JSEARCH_API_KEY=

# Email (Django built-in SMTP → AWS SES later)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Monitoring
SENTRY_DSN=

# Stripe (post-MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Next.js (prefix with NEXT_PUBLIC_ to expose to browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
